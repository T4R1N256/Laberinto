# Compiler
cxx = g++
cxxflags = -Wall -Wextra -std=c++20

# Compiler rule
rule compile
    command = $cxx $cxxflags -MMD -MF $out.d -c $in -o $out
    depfile = $out.d
    deps = gcc
    description = Compiling $in

# Link rule
rule link
    command = $cxx $in -o  $out
    description = Linking $out

# Building object files
build out/main.o: compile main.cpp
build out/Node.o: compile src/Node.cpp
build out/Queue.o: compile src/Queue.cpp
build out/Stack.o: compile src/Stack.cpp
build out/Linked_List.o: compile src/Linked_List.cpp

# Link executable 
build out/main: link out/main.o out/Node.o out/Linked_List.o out/Stack.o out/Queue.o

default out/main
