# Compiler
cxx = g++
cxxflags = -Wall -Wextra -std=c++20

# Compiler rule
rule compile
    command = $cxx $cxxflags -MMD -MF $out.d -c $in -o $out
    depfile = $out.d
    deps = gcc
    description = Compiling $in

# Link rule
rule link
    command = $cxx $in -o  $out
    description = Linking $out

# Building object files
build out/main.o: compile main.cpp
build out/Node.o: compile src/Node.cpp
build out/TDA_Lista_Circular_Doble.o: compile src/TDA_Lista_Circular_Doble.cpp

# Link executable 
build out/main: link out/main.o out/Node.o out/TDA_Lista_Circular_Doble.o

default out/main
